CREATE TABLE TBL_SIHMS_USERDETAILS (
    USERID    NUMBER GENERATED ALWAYS AS IDENTITY,
    USERNAME  VARCHAR2(15 CHAR),
    PASS_WORD  VARCHAR2(250 CHAR),
    GROUPID  NUMBER(3, 0),
    FULLNAME  VARCHAR2(60 CHAR),
    EMAIL  VARCHAR2(70 CHAR),
    MOBILE  VARCHAR2(15 CHAR),
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_SIHMS_USERDETAILS_USERID PRIMARY KEY ( USERID )
);
/
CREATE TABLE TBL_SIHMS_CLASSDETAILS (
    CLASSID    NUMBER GENERATED ALWAYS AS IDENTITY,
    CLASSNAME  VARCHAR2(25 CHAR),
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_SIHMS_CLASSDETAILS PRIMARY KEY ( CLASSID )
);
/
CREATE TABLE TBL_SIHMS_STUDENTINFO (
    STUDENTID    NUMBER GENERATED ALWAYS AS IDENTITY,
    STUDENTNAME  VARCHAR2(60 CHAR),
    PHONENO  VARCHAR2(15 CHAR),
    MAILID  VARCHAR2(60 CHAR),
    PARENTNAME  VARCHAR2(60 CHAR),
    PARENTMOBILE  VARCHAR2(15 CHAR),
    PARENTMAIL  VARCHAR2(60 CHAR),
    ADDRESS  VARCHAR2(300 CHAR),
    CLASSNO  NUMBER (3, 0),
    USERID    NUMBER,
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_SIHMS_STUDENTINFO PRIMARY KEY ( STUDENTID )
);
/
CREATE TABLE TBL_SIHMS_SCHEDULESCLASS (
    SCHEDULESCLASS    NUMBER GENERATED ALWAYS AS IDENTITY,
    CLASSNO  NUMBER(3, 0),
    SCHEDULEDATE  DATE,
    FROMTIME  VARCHAR(16 CHAR),
    TOTIME  VARCHAR(16 CHAR),
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_SIHMS_SCHEDULESCLASS PRIMARY KEY ( SCHEDULESCLASS )
);
/
CREATE TABLE TBL_SIHMS_ASIGN_HOMEWORK (
    HOMEWORK_ID    NUMBER GENERATED ALWAYS AS IDENTITY,
    CLASSNO  NUMBER(3, 0),
    STUDENT_ID  NUMBER,
    HOMEWORK  VARCHAR(3000 CHAR),
    DUE_DATE  DATE,
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_SIHMS_ASIGN_HOMEWORK PRIMARY KEY ( HOMEWORK_ID )
);